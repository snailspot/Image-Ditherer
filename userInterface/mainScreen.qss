
QWidget {
    background-color: rgb(20,20,20);
}

QPushButton{
    font: 11pt \"Cascadia Code\";
    text-align: center;
    color: rgb(191, 191, 191);
    border: 2px solid rgb(20,20,20);
    padding: 6px 0px;
    margin-bottom: 10px;
}

QPushButton#topNav:hover{
    color: rgb(231, 231, 231);
    border-bottom: 2px solid rgb(231, 231, 231);
    
}

QPushButton#bottomNav:hover{
    color: rgb(231, 231, 231);
    border-top: 2px solid rgb(231, 231, 231);
}

QPushButton#topNav:checked{
    border-bottom: 2px solid rgb(191, 191, 191);
}

QPushButton#ColourPicker:hover{
    border-radius: 16px;
}

QLabel{
    font: 11pt \"Cascadia Code\";
    text-align: center;
    color: rgb(231, 231, 231);
}


QFrame#border {
    background-color: rgb(107, 107, 107);
}

QSlider{
    margin: 0px;
}
QSlider::groove:horizontal{
    border-radius: 2px;
    height: 12px;
    margin: 0px;
    background-color: rgb(83, 83, 83);
}
QSlider::groove:hover:horizontal{
    background-color: rgb(107, 107, 107);
}
QSlider::handle:horizontal{
    border: none;
    height: 15px;
    width: 25px;
    margin: 0px;
    border-radius: 3px;
    background-color: rgb(191, 191, 191);
}
QSlider::handle:horizontal:hover{
    background-color: rgb(231, 231, 231);
}
QComboBox{
    background-color: rgb(83, 83, 83);
    border-radius: 3px;
    border: none;
    text-align: center;
    padding: 0px 8px;
    font: 11pt \"Cascadia Code\";
    color: rgb(231, 231, 231);
}
QComboBox:hover{
    background-color: rgb(107, 107, 107);
}
QComboBox::drop-down{
    border:none;
    width: 25px;
}
QComboBox::down-arrow{
    image: url(./assets/combo_box_down_arrow.png);
    width: 12px;
    height: 12px
}
QComboBox QAbstractItemView {
    background-color: rgb(83, 83, 83);
    color:  rgb(191, 191, 191);
    outline:none;
    selection-background-color: rgb(107, 107, 107);
    selection-color: rgb(231, 231, 231);
    border:none;
    border-radius: 5px;
}
